<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pack_card"
    android:layout_width="match_parent"
    android:layout_height="76dp"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="3dp"
    android:background="@drawable/bg_content_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="10dp"
    android:paddingVertical="8dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/pack_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:contentDescription="@null"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_photo"
        app:shapeAppearanceOverlay="@style/LeviContentThumbnailShape" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pack_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:text="@string/resource_pack_name_placeholder"
            android:textColor="@color/on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/pack_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/pack_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/misans"
            android:maxLines="1"
            android:text="@string/resource_pack_description_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/pack_export_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/export"
        android:padding="9dp"
        android:src="@drawable/ic_export"
        app:tint="@color/on_surface" />

    <ImageButton
        android:id="@+id/pack_overflow_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/more_actions"
        android:padding="8dp"
        android:src="@drawable/ic_more_vert"
        app:tint="@color/on_surface" />

    <ImageView
        android:id="@+id/pack_selection_indicator"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_search_box"
        android:contentDescription="@string/selected"
        android:padding="7dp"
        android:src="@drawable/ic_check"
        android:visibility="gone"
        app:tint="@color/primary" />
</LinearLayout>
