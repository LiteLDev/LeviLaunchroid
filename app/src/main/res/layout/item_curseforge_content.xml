<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="5dp"
    android:layout_marginVertical="3dp"
    android:paddingHorizontal="11dp"
    android:paddingVertical="10dp"
    android:background="@drawable/bg_cf_item"
    android:foreground="?android:attr/selectableItemBackground"
    android:clickable="true"
    android:focusable="true">

    <ImageView
        android:id="@+id/mod_icon"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:background="@drawable/bg_cf_icon"
        android:clipToOutline="true"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_minecraft_cube"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <TextView
        android:id="@+id/mod_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="11dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/on_surface"
        app:layout_constraintStart_toEndOf="@id/mod_icon"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:text="Furnicraft Addon" />

    <TextView
        android:id="@+id/mod_author"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/mod_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mod_title"
        tools:text="by RobertGamer69" />

    <TextView
        android:id="@+id/mod_description"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:maxLines="2"
        android:ellipsize="end"
        android:fontFamily="@font/misans"
        android:textSize="12sp"
        android:textColor="@color/text_secondary"
        app:layout_constraintStart_toStartOf="@id/mod_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mod_author"
        tools:text="Beautiful furniture and decorations for your Minecraft worlds" />

    <TextView
        android:id="@+id/mod_metadata"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:fontFamily="@font/misans"
        android:textSize="10sp"
        android:textColor="@color/primary"
        app:layout_constraintStart_toStartOf="@id/mod_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/mod_description"
        app:layout_constraintBottom_toBottomOf="parent"
        tools:text="1.2M downloads · 2026-10-11 · Addons" />

</androidx.constraintlayout.widget.ConstraintLayout>
