<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:layout_marginVertical="4dp"
    android:background="@drawable/bg_flat_layer_item"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp">

    <ImageView
        android:id="@+id/drag_handle"
        android:layout_width="32dp"
        android:layout_height="match_parent"
        android:contentDescription="@string/reorder_layer"
        android:padding="6dp"
        android:src="@drawable/ic_drag_handle"
        android:tint="@color/text_secondary" />

    <TextView
        android:id="@+id/layer_number"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_marginStart="2dp"
        android:background="@drawable/bg_circle"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/on_primary"
        android:textSize="12sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/block_edit"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:background="@drawable/bg_edit_text"
        android:fontFamily="@font/misans"
        android:hint="@string/block_id_hint"
        android:inputType="text"
        android:maxLines="1"
        android:paddingHorizontal="10dp"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:fontFamily="@font/misans"
        android:text="×"
        android:textColor="@color/text_secondary"
        android:textSize="14sp" />

    <EditText
        android:id="@+id/count_edit"
        android:layout_width="58dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/bg_edit_text"
        android:fontFamily="@font/misans"
        android:gravity="center"
        android:hint="1"
        android:inputType="number"
        android:maxLength="3"
        android:paddingHorizontal="6dp"
        android:text="1"
        android:textColor="@color/on_surface"
        android:textColorHint="@color/text_secondary"
        android:textSize="13sp" />

    <ImageButton
        android:id="@+id/delete_layer_button"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginStart="6dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/delete_layer"
        android:padding="9dp"
        android:src="@drawable/ic_delete"
        android:tint="@color/error" />

</LinearLayout>
